{
 "base_status": {
  "title": "Base de pedidos: última carga",
  "tool": "query_dataset",
  "args": {
   "dataset": "vw_etl_load_status",
   "filters": [
    {
     "column": "dest_table",
     "op": "in",
     "value": "(ev_fact_order_item,gc_fact_order_item)"
    },
    {
     "column": "status",
     "op": "eq",
     "value": "OK"
    }
   ],
   "limit": 6,
   "order": "started_at.desc",
   "select": [
    "dest_table",
    "window_end",
    "finished_at"
   ]
  }
 },
