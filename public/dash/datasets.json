 "cf_ord": {
  "title": "Confraria: pedidos por plano",
  "tool": "query_dataset",
  "args": {
   "dataset": "vw_gc_fact_order_item",
   "filters": [
    {
     "column": "created_at_datetime",
     "op": "gte",
     "value": "{{ini}}"
    },
    {
     "column": "created_at_datetime",
     "op": "lte",
     "value": "{{fim}}"
    },
    {
     "column": "is_flash_paid",
     "op": "eq",
     "value": "1"
    },
    {
     "column": "consolidated_store",
     "op": "eq",
     "value": "Confraria"
    }
   ],
   "limit": 1000,
   "order": "order_increment_id.asc",
   "select": [
    "order_increment_id",
    "assinatura_plano",
    "assinatura_periodicidade",
    "status",
    "is_bottle",
    "rec:price_to_pay.sum()",
    "frete:item_shipping_amount.sum()",
    "qtd:item_amount.sum()",
    "ts:created_at_datetime.min()"
   ]
  }
 },
 "cf_serie": {
  "title": "Confraria: receita no tempo",
  "tool": "query_dataset",
  "args": {
   "dataset": "vw_gc_fact_order_item",
   "filters": [
    {
     "column": "created_at_datetime",
     "op": "gte",
     "value": "{{ini}}"
    },
    {
     "column": "created_at_datetime",
     "op": "lte",
     "value": "{{fim}}"
    },
    {
     "column": "is_flash_paid",
     "op": "eq",
     "value": "1"
    },
    {
     "column": "status",
     "op": "neq",
     "value": "signature_created"
    },
    {
     "column": "consolidated_store",
     "op": "eq",
     "value": "Confraria"
    },
    {
     "column": "assinatura_master_sku",
     "op": "like",
     "value": "con-*"
    },
    {
     "column": "assinatura_plano",
     "op": "neq",
     "value": "Grand 200"
    },
    {
     "column": "assinatura_plano",
     "op": "neq",
     "value": "Grand 250"
    },
    {
     "column": "assinatura_plano",
     "op": "neq",
     "value": "Grand 500"
    }
   ],
   "limit": 1000,
   "select": [
    "partition_field",
    "rec:price_to_pay.sum()",
    "frete:item_shipping_amount.sum()"
   ]
  }
 },
