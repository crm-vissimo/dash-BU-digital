
# Redshift
REDSHIFT_HOST=
REDSHIFT_PORT=5439
REDSHIFT_DATABASE=
REDSHIFT_USER=
REDSHIFT_PASSWORD=
# Schema das tabelas de pedidos (padrão: dora_red_aggregations)
REDSHIFT_SCHEMA=dora_red_aggregations

# Google Sheets/Drive: JSON da conta de serviço em base64
GOOGLE_SERVICE_ACCOUNT_JSON=


# Login Google (NextAuth v5). AUTH_SECRET: `npx auth secret`
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# opcional, padrão: vissimo.com.br,evino.com.br,grandcru.com.br
ALLOWED_DOMAINS=
